# MongoDB
# For Atlas, use the official mongodb+srv URI; Atlas SRV/TXT records provide the host list and options.
# In Next.js local development, .env.local takes precedence over duplicate values in .env.
# Keep real credentials in ignored local env files or deployment environment settings, never in source control.
# For local development
MONGODB_URI=mongodb://localhost:27017/qr-attendance

# For production (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# SMTP / Email delivery configuration (recommended: use App Password or provider credentials)
EMAIL=your_email@gmail.com
# Optional provider login; for Gmail, omit this or set it to EMAIL.
# SMTP_USER=your_provider_login@example.com
EMAIL_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM_NAME=Abhivriddhi Admin
# Persistent email queue pacing and daily sending ceiling
EMAIL_DELAY_MS=1000
EMAIL_DAILY_LIMIT=1500

# Random secret used by the scheduled Vercel job processor (Authorization: Bearer).
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# HMAC key used only by the server to issue event ticket IDs
TICKET_SAUCE=replace_with_a_long_random_server_only_secret

# Google service-account JSON, stored as a single-line JSON string on the server
# Share each source spreadsheet and Slides template with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n","client_email":"replace-me@replace-me.iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}

# JWT secret: use a cryptographically random value at least 32 bytes long.
JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET

# One-time seed secret for POST /api/auth/seed; the route refuses to seed when any admin already exists.
# Use a cryptographically random value at least 32 bytes long; remove it after creating the first admin.
SEED_KEY=REPLACE_WITH_32_BYTE_RANDOM_SEED

# Contact Form Configuration (Optional)
# Recipient of contact messages (defaults to abhivriddhi@vit.edu or EMAIL above)
CONTACT_RECIPIENT_EMAIL=abhivriddhi@vit.edu
# Allowed origin for CORS in production (e.g. https://abhivriddhi.in)
CORS_ORIGIN=http://localhost:5173
